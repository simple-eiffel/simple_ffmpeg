<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-22-0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration-1-22-0 http://www.eiffel.com/developers/xml/configuration-1-22-0.xsd" name="simple_ffmpeg" uuid="B7F3E8A1-5C2D-4E9F-A1B3-C7D8E9F0A1B2" library_target="simple_ffmpeg">
	<description>FFmpeg multimedia library for Eiffel - CLI mode (uses ffmpeg.exe)</description>
	<target name="simple_ffmpeg">
		<description>CLI mode - requires ffmpeg.exe in PATH, no SDK needed</description>
		<root all_classes="true"/>
		<file_rule>
			<exclude>/EIFGENs$</exclude>
			<exclude>/\.git$</exclude>
			<exclude>/testing$</exclude>
			<exclude>/sdk$</exclude>
		</file_rule>
		<option warning="warning" syntax="provisional" manifest_array_type="mismatch_warning">
			<assertions precondition="true" postcondition="true" check="true" invariant="true" loop="true" supplier_precondition="true"/>
		</option>
		<setting name="console_application" value="true"/>
		<setting name="dead_code_removal" value="feature"/>
		<capability>
			<concurrency support="scoop" use="scoop"/>
			<void_safety support="all" use="all"/>
		</capability>
		<library name="base" location="$ISE_LIBRARY/library/base/base.ecf"/>
		<library name="time" location="$ISE_LIBRARY/library/time/time.ecf"/>
		<library name="simple_process" location="$SIMPLE_EIFFEL/simple_process/simple_process.ecf"/>
		<library name="simple_file" location="$SIMPLE_EIFFEL/simple_file/simple_file.ecf"/>
		<cluster name="src" location="./src/" recursive="false"/>
		<cluster name="cli" location="./src/cli/" recursive="true"/>
		<external_include location="$SIMPLE_EIFFEL/simple_ffmpeg/Clib">
			<description>Stub header for CLI mode compilation</description>
		</external_include>
	</target>
	<target name="simple_ffmpeg_sdk" extends="simple_ffmpeg">
		<description>SDK mode - requires FFmpeg development libraries</description>
		<file_rule>
			<exclude>/EIFGENs$</exclude>
			<exclude>/\.git$</exclude>
			<exclude>/testing$</exclude>
			<exclude>/cli$</exclude>
		</file_rule>
		<cluster name="src" location="./src/" recursive="false"/>
		<cluster name="sdk" location="./src/sdk/" recursive="true"/>
		<external_include location="$SIMPLE_EIFFEL/simple_ffmpeg/Clib"/>
		<external_include location="$FFMPEG_SDK/include"/>
		<external_library location="$FFMPEG_SDK/lib/avcodec.lib">
			<condition>
				<platform value="windows"/>
			</condition>
		</external_library>
		<external_library location="$FFMPEG_SDK/lib/avformat.lib">
			<condition>
				<platform value="windows"/>
			</condition>
		</external_library>
		<external_library location="$FFMPEG_SDK/lib/avutil.lib">
			<condition>
				<platform value="windows"/>
			</condition>
		</external_library>
		<external_library location="$FFMPEG_SDK/lib/swscale.lib">
			<condition>
				<platform value="windows"/>
			</condition>
		</external_library>
		<external_library location="$FFMPEG_SDK/lib/swresample.lib">
			<condition>
				<platform value="windows"/>
			</condition>
		</external_library>
	</target>
	<target name="simple_ffmpeg_tests" extends="simple_ffmpeg">
		<root class="TEST_APP" feature="make"/>
		<file_rule>
			<exclude>/EIFGENs$</exclude>
			<exclude>/\.git$</exclude>
		</file_rule>
		<library name="simple_testing" location="$SIMPLE_EIFFEL/simple_testing/simple_testing.ecf"/>
		<cluster name="testing" location="./testing/" recursive="true"/>
	</target>
</system>
